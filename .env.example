# إعدادات الخادم
PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=ضع_هنا_سراً_عشوائياً_طويلاً_جداً
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true

# استعادة كلمة المرور عبر Resend — اختياري لكنه مطلوب لإرسال البريد فعلياً
RESEND_API_KEY=
MAIL_FROM=

# Google OAuth — مطلوب لتفعيل "المتابعة باستخدام Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://nesma-store.onrender.com/api/auth/google/callback

# Admin
ADMIN_EMAIL=younesalkiser712@gmail.com

# GitHub publishing (لوحة الإدارة تنشر المنتجات والصور إلى هذا المستودع)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_PRODUCTS_PATH=public/data/products.json

# Frontend / session cookie configuration
FRONTEND_URL=https://nesma-store.pages.dev
COOKIE_SECURE=true
COOKIE_SAMESITE=none
