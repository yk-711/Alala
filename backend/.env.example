# إعدادات الخادم
PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=ضع_هنا_سراً_عشوائياً_طويلاً_جداً
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://your-domain.example
COOKIE_SECURE=true

# استعادة كلمة المرور عبر Resend — اختياري لكنه مطلوب لإرسال البريد فعلياً
RESEND_API_KEY=
MAIL_FROM=

# Google OAuth — مطلوب لتفعيل "المتابعة باستخدام Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://sotool-store.onrender.com/api/auth/google/callback

# Admin / Supabase product management
ADMIN_EMAIL=your-email@example.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=products

# GitHub publishing (لوحة الإدارة تنشر المنتجات والصور إلى هذا المستودع)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_PRODUCTS_PATH=public/data/products.json
